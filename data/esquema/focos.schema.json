{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "focos.schema.json",
  "title": "focos.json — visor web de la tesis, esquema 1.0.0",
  "type": "object",
  "required": ["esquema", "proyecto", "focos"],
  "additionalProperties": false,
  "properties": {
    "esquema": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "proyecto": {
      "type": "object",
      "required": ["titulo", "subtitulo", "autor", "institucion", "resumen", "periodo", "metodo",
                   "fuentes", "limitaciones", "unidades", "figuras", "resultado_general"],
      "additionalProperties": false,
      "properties": {
        "titulo": {"type": "string"}, "subtitulo": {"type": "string"},
        "autor": {"type": "string"}, "institucion": {"type": "string"}, "resumen": {"type": "string"},
        "periodo": {
          "type": "object", "required": ["inicio", "fin", "dias_evaluables"], "additionalProperties": false,
          "properties": {"inicio": {"type": "string", "format": "date"}, "fin": {"type": "string", "format": "date"},
                         "dias_evaluables": {"type": "integer"}}
        },
        "metodo": {"type": "array", "items": {
          "type": "object", "required": ["paso", "titulo", "texto"], "additionalProperties": false,
          "properties": {"paso": {"type": "integer"}, "titulo": {"type": "string"}, "texto": {"type": "string"}}}},
        "fuentes": {"type": "array", "items": {
          "type": "object", "required": ["nombre", "detalle", "doi"], "additionalProperties": false,
          "properties": {"nombre": {"type": "string"}, "detalle": {"type": "string"}, "doi": {"type": ["string", "null"]}}}},
        "limitaciones": {"type": "array", "items": {"type": "string"}},
        "unidades": {"type": "object", "additionalProperties": {
          "type": "object", "required": ["nombre", "unidad", "convencion"], "additionalProperties": false,
          "properties": {"nombre": {"type": "string"}, "unidad": {"type": "string"}, "convencion": {"type": "string"}}}},
        "figuras": {"type": "array", "items": {"$ref": "#/$defs/figura"}},
        "resultado_general": {
          "type": "object", "required": ["estado", "focos_con_evidencia", "focos_total", "rango_dif", "texto"],
          "additionalProperties": false,
          "properties": {"estado": {"$ref": "#/$defs/estado"}, "focos_con_evidencia": {"type": "integer"},
                         "focos_total": {"type": "integer"}, "rango_dif": {"$ref": "#/$defs/par"}, "texto": {"type": "string"}}
        }
      }
    },
    "focos": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/foco"}}
  },
  "$defs": {
    "estado": {"enum": ["validado", "exploratorio", "descriptivo"]},
    "num": {"type": ["number", "null"]},
    "par": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/num"}},
    "caja": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "figura": {
      "type": "object", "required": ["archivo", "titulo", "pie", "estado", "ancho", "alto"], "additionalProperties": false,
      "properties": {"archivo": {"type": "string"}, "titulo": {"type": "string"}, "pie": {"type": "string"},
                     "estado": {"$ref": "#/$defs/estado"}, "ancho": {"type": "integer"}, "alto": {"type": "integer"}}
    },
    "medias": {
      "type": "object", "required": ["ui", "cuisst", "sshf", "dT"], "additionalProperties": false,
      "properties": {"ui": {"$ref": "#/$defs/num"}, "cuisst": {"$ref": "#/$defs/num"},
                     "sshf": {"$ref": "#/$defs/num"}, "dT": {"$ref": "#/$defs/num"}}
    },
    "foco": {
      "type": "object",
      "required": ["id", "nombre", "nombre_corto", "zona", "zona_nombre", "lat", "lon", "cajas", "referencia",
                   "umbrales", "eventos", "indices", "sshf_anual", "estacional", "resumen", "limitaciones",
                   "figuras", "serie"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z_]+$"},
        "nombre": {"type": "string"}, "nombre_corto": {"type": "string"},
        "zona": {"enum": ["norte", "central", "centrosur"]}, "zona_nombre": {"type": "string"},
        "lat": {"type": "number", "minimum": -45, "maximum": -15},
        "lon": {"type": "number", "minimum": -80, "maximum": -68},
        "cajas": {"type": "object", "required": ["nucleo", "oceanica", "viento"], "additionalProperties": false,
                  "properties": {"nucleo": {"$ref": "#/$defs/caja"}, "oceanica": {"$ref": "#/$defs/caja"},
                                 "viento": {"$ref": "#/$defs/caja"}}},
        "referencia": {"type": "string"},
        "umbrales": {"type": "object", "required": ["ui", "cuisst_mensual"], "additionalProperties": false,
                     "properties": {"ui": {"type": "number"},
                                    "cuisst_mensual": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": "number"}}}},
        "eventos": {"type": "object",
                    "required": ["dias_evento", "dias_resto", "rachas", "duracion_media_dias", "frac_un_dia"],
                    "additionalProperties": false,
                    "properties": {"dias_evento": {"type": "integer"}, "dias_resto": {"type": "integer"},
                                   "rachas": {"type": "integer"}, "duracion_media_dias": {"type": "number"},
                                   "frac_un_dia": {"type": "number"}}},
        "indices": {"type": "object", "required": ["estado", "todos", "evento"], "additionalProperties": false,
                    "properties": {"estado": {"$ref": "#/$defs/estado"}, "todos": {"$ref": "#/$defs/medias"},
                                   "evento": {"$ref": "#/$defs/medias"}}},
        "sshf_anual": {
          "type": "object",
          "required": ["estado", "dif", "ic95", "p", "p_holm", "significativo_holm", "crudo_evento", "crudo_resto",
                       "categoria", "etiqueta"],
          "additionalProperties": false,
          "properties": {"estado": {"const": "validado"}, "dif": {"type": "number"}, "ic95": {"$ref": "#/$defs/par"},
                         "p": {"type": "number"}, "p_holm": {"type": "number"}, "significativo_holm": {"type": "boolean"},
                         "crudo_evento": {"type": "number"}, "crudo_resto": {"type": "number"},
                         "categoria": {"enum": ["evidencia", "positivo_sin_ajuste", "sin_diferencia"]},
                         "etiqueta": {"type": "string"}}
        },
        "estacional": {
          "type": "object", "required": ["estado", "nota", "estaciones"], "additionalProperties": false,
          "properties": {
            "estado": {"const": "exploratorio"}, "nota": {"type": "string"},
            "estaciones": {"type": "array", "minItems": 4, "maxItems": 4, "items": {
              "type": "object",
              "required": ["est", "nombre", "dias_evento", "dif", "ic95", "p", "p_holm32", "supera_holm32"],
              "additionalProperties": false,
              "properties": {"est": {"enum": ["DJF", "MAM", "JJA", "SON"]}, "nombre": {"type": "string"},
                             "dias_evento": {"type": "integer"}, "dif": {"$ref": "#/$defs/num"},
                             "ic95": {"$ref": "#/$defs/par"}, "p": {"$ref": "#/$defs/num"},
                             "p_holm32": {"$ref": "#/$defs/num"}, "supera_holm32": {"type": "boolean"}}}}
          }
        },
        "resumen": {"type": "string"},
        "limitaciones": {"type": "array", "items": {"type": "string"}},
        "figuras": {"type": "array", "items": {"$ref": "#/$defs/figura"}},
        "serie": {"type": "string", "pattern": "^series/[a-z_]+\\.json$"}
      }
    }
  }
}
